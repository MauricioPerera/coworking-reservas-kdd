    "knowledge/contracts/shared-booking-ui.md"
  ],
  "implementation": [
    "example/booking-model.mjs",
    "example/booking-storage.mjs",
    "example/client.mjs",
    "example/index.html",
    "example/server.mjs",
    "example/shared-store.mjs",
    "example/shared-api.mjs",
    "example/shared-client.mjs"
  ],
  "pm": [
    "README.md",
    "docs/REVIEW.md",
    "docs/OBJECTIVE.md",
    "docs/VALIDATION.md",
    "specs/CONTRACT-01-reservas.md",
    "docs/reports/CONTRACT-01-REPORT.md",
    "docs/reports/CONTRACT-01-EVIDENCE.json",
    "CHANGELOG.md",
    "docs/I18N-IMPACT.md",
    "specs/CONTRACT-02-idiomas.md",
    "docs/reports/CONTRACT-02-REPORT.md",
    "docs/reports/CONTRACT-02-EVIDENCE.json",
    "specs/CONTRACT-03-concurrencia.md",
    "docs/CONCURRENCY-IMPACT.md",
    "docs/reports/CONTRACT-03-REPORT.md",
    "docs/reports/CONTRACT-03-EVIDENCE.json"
  ],
  "required_kinds": [
    "functional",
    "adversarial",
    "ui"
  ],
  "checks": [
    {
      "name": "kdd-metadata",
      "kind": "structural",
      "argv": [
        "node",
        "scripts/validate-kdd.mjs",
        "--metadata-only"
      ],
      "timeout": 60
    },
    {
      "name": "functional",
      "kind": "functional",
      "argv": [
        "node",
        "--test",
        "tests/report.functional.test.mjs",
        "tests/domain.test.mjs",
        "tests/storage.test.mjs",
        "tests/subprocess.test.mjs",
        "tests/approval.test.mjs",
        "tests/environment.test.mjs",
        "tests/server.test.mjs"
      ],
      "timeout": 60
    },
    {
      "name": "adversarial",
      "kind": "adversarial",
      "argv": [
        "node",
        "--test",
        "tests/report.adversarial.test.mjs",
        "tests/mutations.test.mjs"
      ],
      "timeout": 60
    },
    {
      "name": "ui",
      "kind": "ui",
      "argv": [
        "node",
        "--test",
        "tests/ui-oracle.test.mjs"
      ],
      "timeout": 60
    },
    {
      "name": "ui-languages",
      "kind": "ui",
      "argv": [
        "node",
        "--test",
        "tests/locale-ui.test.mjs"
      ],
      "timeout": 60
    },
    {
      "name": "shared-api",
      "kind": "functional",
      "argv": [
        "node",
        "--test",
        "tests/shared-api.test.mjs"
      ],
      "timeout": 60
    },
    {
      "name": "shared-ui",
      "kind": "ui",
      "argv": [
        "node",
        "--test",
        "tests/shared-ui.test.mjs"
      ],
      "timeout": 60
    }
  ]
}
